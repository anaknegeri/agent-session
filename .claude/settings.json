{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agent-session resume --agent claude",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agent-session checkpoint --label auto",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}